# /etc/pideck/screen.env  (chmod 600: contains the MQTT password)
MQTT_HOST=192.168.10.120
MQTT_PORT=1883
MQTT_USER=pideck
MQTT_PASSWORD=change-me
PIDECK_ID=pideck

# Wake the screen when it is touched while off (the waking tap is swallowed)
WAKE_ON_TOUCH=1

# Optional local idle dim: after this many seconds without touch, dim to IDLE_DIM_LEVEL (0-255).
# 0 disables it; Home Assistant automations can handle dimming instead.
IDLE_DIM_AFTER=0
IDLE_DIM_LEVEL=25
